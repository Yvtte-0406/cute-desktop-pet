{
  "name": "white-fox-desktop-pet",
  "version": "0.3.1",
  "private": true,
  "description": "阿泠 · 本地静音桌宠",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "electron . --preview",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check rig.js && node --check motion.js && node --check todo-model.cjs",
    "test": "node --test motion.test.cjs sizing.test.cjs todo-model.test.cjs",
    "package": "node build-app.cjs"
  },
  "build": {
    "appId": "cn.yvtte.whitefox",
    "productName": "阿泠",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer.js",
      "rig.js",
      "motion.js",
      "sprites.js",
      "window-shape.js",
      "sizing.cjs",
      "todo-model.cjs",
      "index.html",
      "style.css",
      "assets/fox.png",
      "assets/layers/**"
    ],
    "win": {
      "icon": "assets/app.ico",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3"
  }
}
